    {
      "order": 1755,
      "id": "18-185-q-701",
      "type": "question",
      "section_id": "185",
      "number": "701",
      "level": "standard",
      "is_frequent": false,
      "en": "In many of the developing countries of Asia and Africa where the urbanization process has only recently begun, about ( ) of the population lives in urban areas.",
      "options": [
        "① one of three",
        "② one-third",
        "③ every three persons",
        "④ the third"
      ],
      "q_type": "multiple_choice",
      "ja": "都市化の進行がごく最近になって始まったばかりのアジアやアフリカの発展途上国の多くでは、人口の約3分の1が都市部に住んでいる。",
      "answer": "②",
      "source_univ": "成蹊大"
    },
    {
      "order": 1756,
      "id": "18-185-e-701",
      "type": "explanation",
      "target_q": "18-185-q-701",
      "title": "",
      "label": "◆one-third of A 「A の3分の1」",
      "content": [
        { "text": "分数は〈分子＋分母〉で表す。分子には one, two, three などの基数を、分母には third, fifth, sixth などの序数を使う。分子が2以上のときは分母を複数形にする (→ 380) 。\none fifth 「5分の1」、 two fifths 「5分の2」" }
      ],
      "solution": [],
      "appendix": [
        { "tag": "△注意", "text": "分子と分母の間にはハイフン (-) をつける場合と、つけない場合の両方がある。" }
      ]
    },
