    },
    {
      "order": 1760,
      "id": "18-185-e-703",
      "type": "explanation",
      "target_q": "18-185-q-703",
      "title": "",
      "label": "◆a year and a half / one and a half years 「1年半」",
      "content": [
        { "text": "a year and a half は文字どおり「1年＋（1年の）半分＝1年半」という意味。同意表現の one and a half years は、 one and a half 「1＋半分」が year を修飾しているので、複数形 years になる。" }
      ],
      "solution": [],
      "appendix": [
        { "tag": "プラス", "label": "year 以外に hour / month / century などを用いた表現は以下のとおり。", "text": "a month [an hour] and a half / one and a half months [hours] 「1か月半［1時間半］」" },
        { "tag": "選択肢", "text": "②, ③ は時間の経過の表現 (時間+ have passed since ...) → 30" }
      ]
    },
