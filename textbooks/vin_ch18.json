    {
      "order": 1682,
      "id": "18-177-s-080",
      "type": "summary_box",
      "target_s": "177",
      "number": "080",
      "title": "不可算名詞の用法",
      "content": [
        { "text": "英語の名詞には、可算名詞（数えられる名詞）と、不可算名詞（数えられない名詞）という区別がある。可算名詞には a / an をつけることができ、複数形がある。不可算名詞に a / an をつけることはできず、複数形もない。" },
        { "label": "A. 不可算名詞（= 数えられない名詞）", "items": [
          { "tag": "□", "en": "damage", "ja": "「損害／被害」", "note": "→ 677" },
          { "tag": "□", "en": "fun", "ja": "「楽しみ」" },
          { "tag": "□", "en": "harm", "ja": "「害」" },
          { "tag": "□", "en": "progress", "ja": "「進歩／進行」", "note": "→ 678" },
          { "tag": "□", "en": "traffic", "ja": "「交通（量）」", "note": "→ 679" },
          { "tag": "□", "en": "wealth", "ja": "「富／財産」" },
          { "tag": "□", "en": "weather", "ja": "「天気」" }
        ]},
        { "label": "B. 〈a piece of + 不可算名詞〉", "text": "以下の不可算名詞は、 a piece of A 「1つの A」、 two pieces of A 「2つの A」、 many pieces of A 「たくさんの A」のようにして数を表すことができる。2つ以上では複数形 pieces とすることに注意。", "items": [
          { "tag": "□", "en": "advice", "ja": "「助言／忠告」", "note": "→ 672" },
          { "tag": "□", "en": "baggage [luggage]", "ja": "「（旅行時の）手荷物」", "note": "→ 676" },
          { "tag": "□", "en": "equipment", "ja": "「装置」" },
          { "tag": "□", "en": "evidence", "ja": "「証拠」" },
          { "tag": "□", "en": "furniture", "ja": "「家具」", "note": "→ 673" },
          { "tag": "□", "en": "homework", "ja": "「宿題」", "note": "→ 675" },
          { "tag": "□", "en": "housework", "ja": "「家事」" },
          { "tag": "□", "en": "information", "ja": "「情報」", "note": "→ 674" },
          { "tag": "□", "en": "knowledge", "ja": "「知識」" },
          { "tag": "□", "en": "machinery", "ja": "「機械（類）」", "appendix": [ { "tag": "cf.", "text": "可算名詞 machine 「機械」" } ] },
          { "tag": "□", "en": "news", "ja": "「知らせ」" },
          { "tag": "□", "en": "poetry", "ja": "「詩」", "appendix": [ { "tag": "cf.", "text": "可算名詞 poem 「詩」" } ] },
          { "tag": "□", "en": "scenery", "ja": "「景色」", "appendix": [ { "tag": "cf.", "text": "可算名詞 scene 「場面／光景」" } ] }
        ]}
      ]
    },
    {
      "order": 1683,
      "id": "18-177-q-672",
      "type": "question",
      "section_id": "177",
      "number": "672",
      "level": "standard",
      "is_frequent": true,
      "en": "I wonder if anyone can give me (good advices / advice) about how to improve my English.",
      "q_type": "error_correction",
      "ja": "どうすれば英語が上達するか、だれか良いアドバイスをくれないかな。",
      "answer": "advice",
      "source_univ": "徳山大"
    },
    {
      "order": 1684,
      "id": "18-177-e-672",
      "type": "explanation",
      "target_q": "18-177-q-672",
      "title": "",
      "label": "◆不可算名詞 advice 「助言／忠告」",
      "content": [],
      "solution": [
        { "text": "advice は不可算名詞。複数形の (×) advices という形はない。" }
      ],
      "appendix": [
        { "tag": "選択肢", "text": "① は wonder if SV 「…か（どうかな）と思う」 (→ 274), ④ は how to do 「…の仕方」 (→ 115)" },
        { "tag": "重要", "text": "give A advice (about B) 「A に（B に関する）アドバイスをする」" }
      ]
    },
    {
      "order": 1685,
      "id": "18-177-q-673",
      "type": "question",
      "section_id": "177",
      "number": "673",
      "level": "standard",
      "is_frequent": false,
      "en": "We've just bought ( ), such as tables, chairs, etc.",
      "options": [
        "① a few new garden furniture",
        "② some new garden furnitures",
        "③ many new garden furnitures",
        "④ some new garden furniture"
      ],
      "q_type": "multiple_choice",
      "ja": "私たちは、テーブルやイスなどの新しい庭園家具をいくつか購入したばかりだ。",
      "answer": "④",
      "source_univ": "亜細亜大"
    },
    {
      "order": 1686,
      "id": "18-177-e-673",
      "type": "explanation",
      "target_q": "18-177-q-673",
      "title": "",
      "label": "◆不可算名詞 furniture 「家具」",
      "content": [],
      "solution": [
        { "text": "furniture は不可算名詞。複数形の (×) furnitures という形はない。" }
      ],
      "appendix": [
        { "tag": "選択肢", "text": "可算名詞の「数が多い／数が少ない／数がほとんどない」は many / a few / few で表し、不可算名詞の「量が多い／量が少ない／量がほとんどない」は much / a little / little で表す。よって ① a few ... furniture は不可。" }
      ]
    },
